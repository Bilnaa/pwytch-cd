{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environment", "commonLabels", "image", "postgres", "redis", "mosquitto"],
  "definitions": {
    "quantity": {
      "description": "Quantité Kubernetes non nulle : 512Mi, 1Gi, 1.5Gi, 1G, 500M…",
      "type": "string",
      "pattern": "^(0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(\\.[0-9]+)?)(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
    },
    "cpu": {
      "description": "CPU : 100m, 0.5, 1…",
      "oneOf": [
        { "type": "string", "pattern": "^([1-9][0-9]*m|[0-9]+(\\.[0-9]+)?)$" },
        { "type": "number", "exclusiveMinimum": 0 }
      ]
    },
    "resourceList": {
      "type": "object",
      "properties": {
        "cpu": { "$ref": "#/definitions/cpu" },
        "memory": { "$ref": "#/definitions/quantity" },
        "ephemeral-storage": { "$ref": "#/definitions/quantity" }
      },
      "additionalProperties": false
    },
    "resources": {
      "description": "requests et limits d'un conteneur, comme dans un manifest.",
      "type": "object",
      "properties": {
        "requests": { "$ref": "#/definitions/resourceList" },
        "limits": { "$ref": "#/definitions/resourceList" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "environment": {
      "description": "dev ou prod. Vide : le namespace de la release.",
      "type": "string",
      "enum": ["", "dev", "prod"]
    },
    "commonLabels": {
      "description": "Labels en plus, valeurs en texte.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "image": {
      "type": "object",
      "required": ["registry", "repositoryPrefix", "tag", "pullPolicy"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "repositoryPrefix": { "type": "string", "minLength": 1 },
        "tag": {
          "description": "sha complet d'un commit du repo CI. Vide seulement tant qu'aucun template ne l'utilise (lint).",
          "type": "string",
          "pattern": "^([0-9a-f]{40})?$"
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["image", "credentialsSecret", "databases", "storage", "resources"],
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "credentialsSecret": {
          "description": "Secret créé à la main avec POSTGRES_USER et POSTGRES_PASSWORD.",
          "type": "string",
          "minLength": 1
        },
        "databases": {
          "description": "Une base par service, créée au premier démarrage si elle n'existe pas.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" }
        },
        "storage": {
          "description": "Taille du volume, par exemple 1Gi.",
          "$ref": "#/definitions/quantity"
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "redis": {
      "type": "object",
      "required": ["image", "resources"],
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "mosquitto": {
      "type": "object",
      "required": ["image", "resources"],
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    }
  }
}
